{
  "manifest_version": 3,
  "name": "트윙클 AI 응답 알림",
  "version": "0.4.0",
  "description": "ChatGPT·Claude·Gemini 웹 응답 종료를 내 PC 캐릭터에 전달합니다.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}